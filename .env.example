# LTA DataMall APIキー。
# LTA DataMallサイト（https://datamall.lta.gov.sg/）でアカウント登録し、
# 「Request for API Access」等のページからAPIキーをリクエストして取得する。
# 取得後、このファイルを `.env` にコピーし、下記に取得したキーを設定すること。
# キーが未設定の場合、サーバーは起動時に警告ログを出し、
# /api/bus-arrival は汎用エラーメッセージを返す（アプリ自体は落ちない）。
LTA_DATAMALL_API_KEY=

# 要確認: dosuru-app/sg-weekend-appが使用中のポートとの衝突有無は未確認。3000番台の空きポートを仮置き。
PORT=3010

# Settings画面「フィードバック」送信先（LINE Messaging API）。
# sg-weekend-app（姉妹アプリ）と同じLINE Official Account/開発者個人アカウントへの
# Push通知をそのまま流用する。未設定の場合、/api/feedback は500エラーを返す。
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=
